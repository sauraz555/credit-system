# ==============================================================================
# Credit Reporting Mechanism System (CRMS) - Environment Configuration Template
# APRA Prudential Standard APS 220 & Privacy Act 1988 Part IIIA Compliant
# Copy this file to .env and configure secret keys prior to deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Persistence (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=crms_user
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=credit_system
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crms_user:your_strong_postgres_password_here@localhost:5432/credit_system

# ------------------------------------------------------------------------------
# 2. Redis Cache & Distributed Task Broker
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Cryptographic Security & Field-Level Encryption
# ------------------------------------------------------------------------------
# SECRET_KEY: 256-bit cryptographically secure string for JWT token generation
SECRET_KEY=change_this_to_a_cryptographically_secure_random_64_char_secret_key

# FIELD_ENCRYPTION_KEY: 32-byte hex-encoded key (64 hex characters) for AES-256-GCM
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# BLIND_INDEX_KEY: 32-byte hex-encoded key (64 hex characters) for HMAC-SHA256 blind indexing
BLIND_INDEX_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# ------------------------------------------------------------------------------
# 4. Token Expiration & Authentication Policies
# ------------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 5. Network & Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Strictly explicit comma-separated origin list. Wildcards (*) are prohibited.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 6. Frontend Environment Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000

# ------------------------------------------------------------------------------
# 7. Application Performance Monitoring & Observability (Sentry)
# ------------------------------------------------------------------------------
# Optional Sentry DSN. Leave empty to disable Sentry telemetry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.2
ENVIRONMENT=production
